#!/bin/sh

set -eu

# The private IPv4 class B range of RFC 1918. Unlike an entry in allow_hosts.d,
# which only gets ports 80 and 443, a network listed here is granted every port
# and every protocol -- that is the point of the directory, because a local
# service is just as likely to sit on 5432, 3000 or 11434 as on 443.
#
# 172.16.0.0/12 is the one that matters even when no LAN is involved: the
# container's default gateway is the Docker bridge (172.17.0.1, the address
# host.docker.internal resolves to), so this is what lets it reach a service
# published on the host, and the bridge that docker-in-docker gives nested
# containers falls in this range as well.
#
# The link-local range 169.254.0.0/16 is deliberately left out of
# allow_networks.d: it carries the cloud metadata service (169.254.169.254),
# which hands instance credentials to anything that asks it, and nothing worth
# reaching lives there.
#
# This does trade away part of what an allowlist buys: every host in this range
# becomes reachable on every port. Delete this file to keep the container from
# reaching it, the host included.
cat <<EOF
172.16.0.0/12
EOF
